# Supabase Dashboard > Project Settings > API (public browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional server-only cache path for the pinned local semantic model.
# MODEL_CACHE_DIR=/tmp/building-issues-models

# Optional for hosts with an empty ephemeral cache; normal prepared inference stays offline.
# SEMANTIC_ALLOW_MODEL_DOWNLOAD=1
